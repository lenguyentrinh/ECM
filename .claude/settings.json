{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw test*)",
      "Bash(./mvnw -B verify*)",
      "Bash(./mvnw clean compile*)",
      "Bash(./mvnw compile*)",
      "Bash(backend/mvnw -f backend/pom.xml *)",
      "Bash(pnpm install*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm --dir frontend install*)",
      "Bash(pnpm --dir frontend run lint*)",
      "Bash(pnpm --dir frontend run build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git blame*)",
      "Bash(docker compose config*)",
      "Bash(docker compose ps*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(grep * *.env*)",
      "Bash(Get-Content *.env*)",
      "Read(./backend/target/**)",
      "Read(./frontend/dist/**)",
      "Read(./frontend/node_modules/**)",
      "Bash(git diff*--output*)",
      "Bash(git*push*--force*)",
      "Bash(git*push* -f*)",
      "Bash(git*reset --hard*)",
      "Bash(git*clean -f*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -f -r*)",
      "Bash(rm --recursive*)",
      "Bash(Remove-Item*-Recurse*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)"
    ]
  }
}